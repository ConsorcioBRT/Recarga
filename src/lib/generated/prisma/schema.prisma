generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cbt {
  CbtId    Int      @id @default(autoincrement())
  CbtNme   String   @db.VarChar(50)
  SttId    Int      @default(1)
  UsrIdAlt Int
  DtaAlt   DateTime @default(now())
  MtvDel   String?  @db.VarChar(250)

  stt stt @relation(fields: [SttId], references: [SttId], onUpdate: Restrict, map: "FK_Cbt_Stt")
  usr usr @relation(fields: [UsrIdAlt], references: [UsrId], onUpdate: Restrict, map: "FK_Cbt_Usr")

  @@index([SttId], map: "Idx_Cbt_SttId")
  @@index([UsrIdAlt], map: "Idx_Cbt_UsrIdAlt")
  @@index([CbtNme], map: "Idx_Cbt_CbtNme")
}

model emp {
  EmpId     Int      @id @default(autoincrement())
  EmpNme    String   @db.VarChar(150)
  EmpRaz    String?  @db.VarChar(150)
  EmpRdz    String?  @db.VarChar(15)
  EmpAtv    String?  @db.VarChar(150)
  EmpCnpj   String?  @db.VarChar(15)
  Enduf     String?  @db.VarChar(2)
  EndCdd    String?  @db.VarChar(50)
  EndLtt    String?  @db.VarChar(20)
  EndLgt    String?  @db.VarChar(20)
  EndCep    String?  @db.VarChar(20)
  EndEmp    String?  @db.VarChar(150)
  EndCpl    String?  @db.VarChar(100)
  EmpLgo    String?  @db.VarChar(150)
  EmpUrl    String?  @db.VarChar(150)
  EmlCtt    String?  @db.VarChar(50)
  EmlFrm    String?  @db.VarChar(50)
  EmlFrmPwd String?  @db.VarChar(50)
  FneCtt    String?  @db.VarChar(20)
  FneWha    String?  @db.VarChar(20)
  RssIns    String?  @db.VarChar(50)
  RssFac    String?  @db.VarChar(50)
  RssTwi    String?  @db.VarChar(50)
  RssYou    String?  @db.VarChar(50)
  TpoPix    String?  @db.Char(1)
  ChvPix    String?  @db.VarChar(150)
  QRPixImg  String?  @db.VarChar(150)
  QRPixCpy  String?  @db.VarChar(150)
  SttId     Int      @default(1)
  UsrIdAlt  Int
  DtaAlt    DateTime @default(now())
  MtvDel    String?  @db.VarChar(250)

  stt     stt       @relation(fields: [SttId], references: [SttId], onUpdate: Restrict, map: "FK_Emp_Stt")
  emp_und emp_und[]
  rcg     rcg[]
  usr     usr[]

  @@index([SttId], map: "Idx_Emp_SttId")
}

model emp_und {
  UndId    Int      @id @default(autoincrement())
  EmpId    Int
  UndNme   String   @db.VarChar(150)
  UndRdz   String?  @db.VarChar(15)
  UndReg   String?  @db.VarChar(50)
  GpsLtd   String?  @db.VarChar(50)
  GpsLgt   String?  @db.VarChar(50)
  PstRcg   Int?
  SttId    Int      @default(1)
  UsrIdAlt Int
  DtaAlt   DateTime @default(now())
  MtvDel   String?  @db.VarChar(250)

  emp emp @relation(fields: [EmpId], references: [EmpId], onUpdate: Restrict, map: "FK_EmpUnd_Emp")
  stt stt @relation(fields: [SttId], references: [SttId], onUpdate: Restrict, map: "FK_EmpUnd_Stt")

  eqp_itm eqp_itm[]
  eqp_loc eqp_loc[]
  rcg     rcg[]

  @@index([EmpId], map: "Idx_EmpUnd_EmpId")
  @@index([SttId], map: "Idx_EmpUnd_SttId")
  @@index([UndNme], map: "Idx_EmpUnd_UndNme")
}

model eqp_fbr {
  EqpFbrId  Int      @id @default(autoincrement())
  EqpFbrNme String   @db.VarChar(50)
  SttId     Int      @default(1)
  UsrIdAlt  Int
  DtaAlt    DateTime @default(now())
  MtvDel    String?  @db.VarChar(250)

  stt     stt       @relation(fields: [SttId], references: [SttId], onUpdate: Restrict, map: "FK_EqpFbr_Stt")
  usr     usr       @relation(fields: [UsrIdAlt], references: [UsrId], onUpdate: Restrict, map: "FK_EqpFbr_Usr")
  eqp_itm eqp_itm[]
  eqp_mdl eqp_mdl[]

  @@index([SttId], map: "Idx_EqpFbr_SttId")
  @@index([UsrIdAlt], map: "Idx_EqpFbr_UsrIdAlt")
  @@index([EqpFbrNme], map: "Idx_EqpFbr_Nme")
}

model eqp_itm {
  EqpItmId     Int      @id @default(autoincrement())
  UndId        Int
  FrnId        Int
  EqpTpoId     Int
  EqpFbrId     Int
  EqpMdlId     Int
  EqpItmCdg    String   @db.VarChar(20)
  EqpItmPlc    String?  @db.VarChar(20)
  EqpItmAnoMdl String?  @db.VarChar(20)
  EqpItmTmh    String   @db.VarChar(20)
  SttId        Int      @default(1)
  UsrIdAlt     Int
  DtaAlt       DateTime @default(now())
  MtvDel       String?  @db.VarChar(250)

  emp_und emp_und @relation(fields: [UndId], references: [UndId], map: "FK_EqpItm_EmpUnd")
  eqp_fbr eqp_fbr @relation(fields: [EqpFbrId], references: [EqpFbrId], map: "FK_EqpItm_EqpFbr")
  eqp_mdl eqp_mdl @relation(fields: [EqpMdlId], references: [EqpMdlId], map: "FK_EqpItm_EqpMdl")
  eqp_tpo eqp_tpo @relation(fields: [EqpTpoId], references: [EqpTpoId], map: "FK_EqpItm_EqpTpo")
  frn     frn     @relation(fields: [FrnId], references: [FrnId], map: "FK_EqpItm_Frn")
  stt     stt     @relation(fields: [SttId], references: [SttId], map: "FK_EqpItm_Stt")
  usr     usr     @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_EqpItm_Usr")

  eqp_loc                eqp_loc[]
  rcg_rcg_CrrIdToeqp_itm rcg[]     @relation("rcg_CrrIdToeqp_itm")
  rcg_rcg_VclIdToeqp_itm rcg[]     @relation("rcg_VclIdToeqp_itm")

  @@index([SttId, EqpTpoId], map: "Idx_EqpItm_Stt_Tpo")
  @@index([UndId], map: "Idx_EqpItm_EmpUnd")
  @@index([EqpFbrId], map: "Idx_EqpItm_EqpFbr")
  @@index([EqpMdlId], map: "Idx_EqpItm_EqpMdl")
  @@index([FrnId], map: "Idx_EqpItm_Frn")
  @@index([UsrIdAlt], map: "Idx_EqpItm_Usr")
  @@index([EqpItmCdg], map: "Idx_EqpItm_Cdg")
  @@index([EqpItmPlc], map: "Idx_EqpItm_Plc")
  @@index([EqpTpoId], map: "Idx_EqpItm_Tpo")
  @@index([SttId], map: "Idx_EqpItm_Stt")
  @@index([EqpItmTmh], map: "Idx_EqpItm_Tmh")
}

model eqp_loc {
  EqpItmId Int
  UndId    Int
  EqpTpoId Int
  SttId    Int      @default(1)
  UsrIdAlt Int
  DtaAlt   DateTime @default(now())
  MtvDel   String?  @db.VarChar(250)

  emp_und emp_und @relation(fields: [UndId], references: [UndId], map: "FK_EqpLoc_EmpUnd")
  eqp_itm eqp_itm @relation(fields: [EqpItmId], references: [EqpItmId], map: "FK_EqpLoc_EqpItm")
  eqp_tpo eqp_tpo @relation(fields: [EqpTpoId], references: [EqpTpoId], map: "FK_EqpLoc_EqpTpo")
  stt     stt     @relation(fields: [SttId], references: [SttId], map: "FK_EqpLoc_Stt")
  usr     usr     @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_EqpLoc_Usr")

  @@id([EqpItmId, UndId])
  @@index([UndId], map: "Idx_EqpLoc_EmpUnd")
  @@index([EqpTpoId], map: "Idx_EqpLoc_EqpTpo")
  @@index([SttId], map: "Idx_EqpLoc_Stt")
  @@index([UsrIdAlt], map: "Idx_EqpLoc_Usr")
}

model eqp_mdl {
  EqpMdlId  Int      @id @default(autoincrement())
  EqpMdlNme String   @db.VarChar(50)
  EqpTpoId  Int
  EqpFbrId  Int
  CbtId     Int
  CpcCrg    Decimal? @db.Decimal(10, 3)
  SttId     Int      @default(1)
  UsrIdAlt  Int
  DtaAlt    DateTime @default(now())
  MtvDel    String?  @db.VarChar(250)

  eqp_itm eqp_itm[]
  eqp_fbr eqp_fbr   @relation(fields: [EqpFbrId], references: [EqpFbrId], map: "FK_EqpMdl_EqpFbr")
  eqp_tpo eqp_tpo   @relation(fields: [EqpTpoId], references: [EqpTpoId], map: "FK_EqpMdl_EqpTpo")
  stt     stt       @relation(fields: [SttId], references: [SttId], map: "FK_EqpMdl_Stt")
  usr     usr       @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_EqpMdl_Usr")

  @@index([EqpFbrId], map: "Idx_EqpMdl_EqpFbr")
  @@index([EqpTpoId], map: "Idx_EqpMdl_EqpTpo")
  @@index([SttId], map: "Idx_EqpMdl_Stt")
  @@index([UsrIdAlt], map: "Idx_EqpMdl_Usr")
  @@index([EqpMdlNme], map: "Idx_EqpMdl_Nme")
}

model eqp_tpo {
  EqpTpoId  Int      @id @default(autoincrement())
  EqpTpoNme String   @db.VarChar(50)
  SttId     Int      @default(1)
  UsrIdAlt  Int
  DtaAlt    DateTime @default(now())
  MtvDel    String?  @db.VarChar(250)

  eqp_itm eqp_itm[]
  eqp_loc eqp_loc[]
  eqp_mdl eqp_mdl[]

  stt stt @relation(fields: [SttId], references: [SttId], map: "FK_EqpTpo_Stt")
  usr usr @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_EqpTpo_Usr")

  @@index([SttId], map: "Idx_EqpTpo_Stt")
  @@index([UsrIdAlt], map: "Idx_EqpTpo_Usr")
  @@index([EqpTpoNme], map: "Idx_EqpTpo_Nme")
}

model frn {
  FrnId    Int      @id @default(autoincrement())
  FrnNme   String   @db.VarChar(50)
  FrnRdz   String   @db.VarChar(50)
  SttId    Int      @default(1)
  UsrIdAlt Int
  DtaAlt   DateTime @default(now())
  MtvDel   String?  @db.VarChar(250)

  eqp_itm eqp_itm[]

  stt stt @relation(fields: [SttId], references: [SttId], map: "FK_Frn_Stt")
  usr usr @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_Frn_Usr")

  @@index([SttId], map: "Idx_Frn_Stt")
  @@index([UsrIdAlt], map: "Idx_Frn_Usr")
  @@index([FrnNme], map: "Idx_Frn_Nme")
}

model psq {
  PsqId    Int      @id @default(autoincrement())
  Psq      String   @db.VarChar(100)
  SttId    Int      @default(1)
  UsrIdAlt Int
  DtaAlt   DateTime @default(now())
  MtvDel   String?  @db.VarChar(250)

  stt     stt       @relation(fields: [SttId], references: [SttId], map: "FK_Psq_Stt")
  usr     usr       @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_Psq_Usr")
  psq_rsp psq_rsp[]

  @@index([SttId], map: "Idx_Psq_Stt")
  @@index([UsrIdAlt], map: "Idx_Psq_Usr")
}

model psq_prg {
  PsqTpoId Int
  PsqPrgId Int      @id @default(autoincrement())
  PsqPrg   String   @db.VarChar(100)
  PsqSqc   Int
  SttId    Int      @default(1)
  UsrIdAlt Int
  DtaAlt   DateTime @default(now())
  MtvDel   String?  @db.VarChar(250)

  psq_tpo psq_tpo   @relation(fields: [PsqTpoId], references: [PsqTpoId], map: "FK_PsqPrg_PsqTpo")
  stt     stt       @relation(fields: [SttId], references: [SttId], map: "FK_PsqPrg_Stt")
  usr     usr       @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_PsqPrg_Usr")
  psq_rsp psq_rsp[]

  @@index([PsqTpoId], map: "Idx_PsqPrg_PsqTpo")
  @@index([SttId], map: "Idx_PsqPrg_Stt")
  @@index([UsrIdAlt], map: "Idx_PsqPrg_Usr")
}

model psq_rsp {
  UndId    Int // Identificador da Unidade
  DtaOpe   DateTime @db.Date // Data da Operação
  TrnId    Int? // Identificador do Turno (1 para Diurno e 2 para Noturno)
  PsqId    Int // Identificador da pesquisa
  PsqTpoId Int // Identificador Tipo de pesquisa
  PsqPrgId Int // Identificador pergunta da pesquisa
  PsqRspId Int      @id @default(autoincrement()) // Identificador resposta da pesquisa
  PsqRsp   Int // Pergunta da pesquisa
  PsqDth   String?  @db.VarChar(250) // Detalhe da pesquisa
  SttId    Int      @default(1) // Status Registro
  UsrIdAlt Int // Id Usuário que cadastrou
  DtaAlt   DateTime @default(now()) // Data Cadastro
  MtvDel   String?  @db.VarChar(250) // Motivo da deleção

  psq_tpo psq_tpo @relation(fields: [PsqTpoId], references: [PsqTpoId], map: "FK_PsqRsp_PsqTpo")
  psq     psq     @relation(fields: [PsqId], references: [PsqId], map: "FK_PsqRsp_Psq")
  stt     stt     @relation(fields: [SttId], references: [SttId], map: "FK_PsqRsp_Stt")
  usr     usr     @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_PsqRsp_Usr")
  psq_prg psq_prg @relation(fields: [PsqPrgId], references: [PsqPrgId], map: "FK_PsqRsp_PsqPrg")

  @@index([PsqTpoId], map: "Idx_PsqRsp_PsqTpo")
  @@index([PsqId], map: "Idx_PsqRsp_Psq")
  @@index([SttId], map: "Idx_PsqRsp_Stt")
  @@index([UsrIdAlt], map: "Idx_PsqRsp_Usr")
  @@index([PsqPrgId], map: "Idx_PsqRsp_PsqPrg")
}

model psq_tpo {
  PsqTpoId Int      @id @default(autoincrement())
  PsqTpo   String   @db.VarChar(100)
  SttId    Int      @default(1)
  UsrIdAlt Int
  DtaAlt   DateTime @default(now()) // PostgreSQL não precisa de @db.Timestamp(0)
  MtvDel   String?  @db.VarChar(250)

  psq_prg psq_prg[]
  psq_rsp psq_rsp[]

  stt stt @relation(fields: [SttId], references: [SttId], map: "FK_PsqTpo_Stt")
  usr usr @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_PsqTpo_Usr")

  @@index([SttId], map: "Idx_PsqTpo_Stt")
  @@index([UsrIdAlt], map: "Idx_PsqTpo_Usr")
}

model rcg {
  RcgId    Int       @id @default(autoincrement())
  RcgIdOrg Int?
  EmpId    Int
  DtaOpe   DateTime  @db.Date
  UndId    Int
  VclId    Int
  CrrId    Int
  CrrCnc   Int
  DtaIni   DateTime
  DtaFin   DateTime?
  SocIni   Int?
  SocFin   Int?
  RcgKwh   Decimal?  @db.Decimal(10, 3)
  OdoIni   Decimal?  @db.Decimal(10, 1)
  OdoFin   Decimal?  @db.Decimal(10, 1)
  SttRcgId Int       @default(6)
  FlhId    Int       @default(0)
  FlhDsc   String?   @db.VarChar(250)
  SttId    Int       @default(1)
  SttIdChk Int?
  UsrIdAlt Int
  DtaAlt   DateTime  @default(now()) @updatedAt
  MtvDel   String?   @db.VarChar(250)

  emp_und                    emp_und @relation(fields: [UndId], references: [UndId], map: "FK_Rcg_EmpUnd")
  emp                        emp     @relation(fields: [EmpId], references: [EmpId], map: "FK_Rcg_Emp")
  eqp_itm_rcg_CrrIdToeqp_itm eqp_itm @relation("rcg_CrrIdToeqp_itm", fields: [CrrId], references: [EqpItmId], map: "FK_Rcg_EqpItm_Crr")
  eqp_itm_rcg_VclIdToeqp_itm eqp_itm @relation("rcg_VclIdToeqp_itm", fields: [VclId], references: [EqpItmId], map: "FK_Rcg_EqpItm_Vcl")
  rcg                        rcg?    @relation("rcgTorcg", fields: [RcgIdOrg], references: [RcgId], onDelete: Restrict, map: "FK_Rcg_Rcg")
  other_rcg                  rcg[]   @relation("rcgTorcg")
  stt_rcg_SttIdTostt         stt     @relation("rcg_SttIdTostt", fields: [SttId], references: [SttId], map: "FK_Rcg_Stt")
  stt_rcg_SttRcgIdTostt      stt     @relation("rcg_SttRcgIdTostt", fields: [SttRcgId], references: [SttId], map: "FK_Rcg_SttRcg")
  usr                        usr     @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_Rcg_Usr")

  @@index([SttRcgId, VclId], map: "Idx_Rcg_SttRcg_Vcl")
  @@index([SttRcgId, VclId, UndId, DtaOpe], map: "Idx_Rcg_SttRcg_Vcl_Und_Dta")
  @@index([UndId], map: "Idx_Rcg_Und")
  @@index([EmpId], map: "Idx_Rcg_Emp")
  @@index([CrrId], map: "Idx_Rcg_Crr")
  @@index([VclId], map: "Idx_Rcg_Vcl")
  @@index([RcgIdOrg], map: "Idx_Rcg_RcgOrg")
  @@index([SttId], map: "Idx_Rcg_Stt")
  @@index([UsrIdAlt], map: "Idx_Rcg_Usr")
}

model stt {
  SttId                 Int       @id @default(autoincrement())
  SttNme                String    @db.VarChar(50)
  SttIdAtu              Int       @default(1)
  UsrIdAlt              Int
  DtaAlt                DateTime  @default(now()) @db.Timestamp(0)
  MtvDel                String?   @db.VarChar(250)
  cbt                   cbt[]
  emp                   emp[]
  emp_und               emp_und[]
  eqp_fbr               eqp_fbr[]
  eqp_itm               eqp_itm[]
  eqp_loc               eqp_loc[]
  eqp_mdl               eqp_mdl[]
  eqp_tpo               eqp_tpo[]
  frn                   frn[]
  psq                   psq[]
  psq_prg               psq_prg[]
  psq_rsp               psq_rsp[]
  psq_tpo               psq_tpo[]
  rcg_rcg_SttIdTostt    rcg[]     @relation("rcg_SttIdTostt")
  rcg_rcg_SttRcgIdTostt rcg[]     @relation("rcg_SttRcgIdTostt")
  usr                   usr[]
  usr_tpo               usr_tpo[]
  trn                   trn[]     @relation(map: "FK_trn_Stt_SttId")

  @@index([SttNme], map: "Idx_Stt")
}

model trn {
  TrnId    Int      @id @default(autoincrement()) // Identificador turno
  Trn      String   @db.VarChar(50) // Descrição do turno
  TrnIni   DateTime @db.Time // Início do turno
  TrnFin   DateTime @db.Time // Final do turno
  SttId    Int      @default(1) // Status Registro
  UsrIdAlt Int // Id Usuário que cadastrou
  DtaAlt   DateTime @default(now()) @updatedAt // Data Cadastro
  MtvDel   String?  @db.VarChar(250) // Motivo da deleção

  stt stt @relation(fields: [SttId], references: [SttId], map: "FK_Trn_Stt")
  usr usr @relation(fields: [UsrIdAlt], references: [UsrId], map: "FK_Trn_Usr")

  @@index([SttId], map: "Idx_Trn_Stt")
  @@index([UsrIdAlt], map: "Idx_Trn_Usr")
}

model usr {
  EmpId    Int
  UsrTpoId Int
  UsrId    Int      @id @default(autoincrement())
  UsrNme   String   @db.VarChar(150)
  UsrLgn   String?  @unique(map: "UQ_Usr_Lgn") @db.VarChar(20)
  UsrCpf   String?  @unique(map: "UQ_Usr_Cpf") @db.VarChar(15)
  UsrEml   String   @unique(map: "UQ_Usr_Eml") @db.VarChar(150)
  UsrPwd   String   @db.VarChar(250)
  UsrFto   String?  @default("avatar.png") @db.VarChar(250)
  SttId    Int      @default(1)
  UsrIdAlt Int
  DtaAlt   DateTime @default(now())
  MtvDel   String?  @db.VarChar(250)

  cbt     cbt[]
  eqp_fbr eqp_fbr[]
  eqp_itm eqp_itm[]
  eqp_loc eqp_loc[]
  eqp_mdl eqp_mdl[]
  eqp_tpo eqp_tpo[]
  frn     frn[]
  psq     psq[]
  psq_prg psq_prg[]
  psq_rsp psq_rsp[]
  psq_tpo psq_tpo[]
  rcg     rcg[]

  emp       emp     @relation(fields: [EmpId], references: [EmpId], map: "FK_Usr_Emp")
  stt       stt     @relation(fields: [SttId], references: [SttId], map: "FK_Usr_Stt")
  usr_tpo   usr_tpo @relation(fields: [UsrTpoId], references: [UsrTpoId], map: "FK_Usr_UsrTpo")
  usr       usr     @relation("usrTousr", fields: [UsrIdAlt], references: [UsrId], map: "FK_Usr_UsrMgr")
  other_usr usr[]   @relation("usrTousr")

  trn trn[] @relation(map: "FK_Usr_Trn")

  @@index([EmpId], map: "Idx_Usr_EmpId")
  @@index([UsrTpoId], map: "Idx_Usr_UsrTpoId")
  @@index([UsrIdAlt], map: "Idx_Usr_UsrMgrId")
  @@index([SttId], map: "Idx_Usr_SttId")
}

model usr_tpo {
  UsrTpoId  Int      @id @default(autoincrement())
  UsrTpoNme String   @unique(map: "IdxU_UsrTpo") @db.VarChar(50)
  SttId     Int      @default(1)
  UsrIdAlt  Int
  DtaAlt    DateTime @default(now()) @db.Timestamp(0)
  MtvDel    String?  @db.VarChar(250)
  usr       usr[]
  stt       stt      @relation(fields: [SttId], references: [SttId], onUpdate: Restrict, map: "FK_UsrTpo_Stt_SttId")

  @@index([SttId], map: "Idx_UsrTpo_SttId")
}

/// View: vw_onibus
model VwOnibus {
  RcgIdOrg           Int?      @map("RcgIdOrg")
  EqpItmId           Int       @id @map("EqpItmId") // ID único
  Onibus             String    @map("Onibus")
  Situacao           String    @map("Situacao")
  Data_Operacao      DateTime? @map("Data_Operacao")
  UndId              Int?      @map("UndId")
  PostoRecarga       String?   @map("PostoRecarga")
  CrrId              Int?      @map("CrrId")
  Carregador         String?   @map("Carregador")
  DataInicio         DateTime? @map("DataInicio")
  DataFinal          DateTime? @map("DataFinal")
  BateriaInicio      Int?      @map("BateriaInicio")
  Bateria            Int?      @map("Bateria")
  BateriaEntregue    Int?      @map("BateriaEntregue")
  Carga_kWh          Decimal?  @map("Carga_kWh") @db.Decimal(10, 3)
  OdometroInicio     Float?    @map("OdometroInicio")
  Odometro           Float?    @map("Odometro")
  KmRodado           Float?    @map("KmRodado")
  Checklist          String?   @map("Checklist")
  Capacidade_Tecnica Decimal   @map("Capacidade_Tecnica") @db.Decimal(10, 3)

  @@map("vw_onibus")
}

